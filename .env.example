# Supabase. Valeurs disponibles dans les paramètres API du projet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Identifiant UUID de l’utilisateur Supabase Auth autorisé.
ADMIN_SUPABASE_USER_ID=

# Gmail. Facultatif si l'envoi automatique est désactivé dans le dashboard.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_EMAIL=

# Optionnel, chemin du navigateur pour produire les PDF en local.
CHROME_EXECUTABLE_PATH=
# Optionnel, archive Chromium sur Vercel. Voir lib/pdf.ts pour la valeur par défaut.
CHROMIUM_REMOTE_EXEC_PATH=
# Optionnel, uniquement pour tester npm start en HTTP sur localhost. Ne pas définir sur Vercel.
# ADMIN_LOCAL_HTTP=1
